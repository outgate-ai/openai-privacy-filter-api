# GPU image — CUDA 12.8 devel + cuDNN, Python 3.12, GPU-enabled torch.
# CUDA 12.8 is required for Blackwell (sm_120, RTX 50xx); it also covers older
# architectures back to sm_70 (Volta). We use the *devel* base (not runtime)
# because OPF's MoE uses Triton kernels that are JIT-compiled at first use and
# require both a C compiler (gcc) and the CUDA headers.
#
# Layer ordering is deliberate: heavy, rarely-changing layers (torch, base
# packages, user setup) come first; the application code is the very last
# layer. A code-only change (the common case for releases) re-pushes only
# the small app layer instead of the ~3.5 GB torch layer.
FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04 AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive \
    OPF_API_HOST=0.0.0.0 \
    OPF_API_PORT=11435 \
    OPF_API_DEVICE=cuda \
    CC=gcc \
    CXX=g++

# --- Layer 1: OS packages + Python 3.12 + pip. Invalidated only when this
# RUN block itself changes.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        software-properties-common curl git ca-certificates gosu \
        gcc g++ \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.12 python3.12-venv python3.12-dev \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.12 /usr/local/bin/python \
    && ln -sf /usr/bin/python3.12 /usr/local/bin/python3 \
    && python -m ensurepip --upgrade \
    && python -m pip install --upgrade pip

# --- Layer 2: torch + cu128 wheels (~3.5 GB). Invalidated only when this
# RUN line changes (torch version bump or CUDA base bump).
RUN python -m pip install --index-url https://download.pytorch.org/whl/cu128 "torch>=2.7"

# --- Layer 3: unprivileged user + cache dir + entrypoint script. Invalidated
# only when the entrypoint script changes (very rare).
RUN useradd --create-home --uid 1000 opf \
    && mkdir -p /home/opf/.opf \
    && chown -R opf:opf /home/opf
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# --- Layer 4: pip-installable project metadata. Invalidated when
# pyproject.toml / README / LICENSE change. Small (~kB).
WORKDIR /app
COPY pyproject.toml README.md LICENSE ./

# --- Layer 5: application source + pip install of the project itself.
# This is the only layer that re-pushes on a typical code-change release;
# it should be a few MB at most.
COPY src ./src
RUN python -m pip install .

WORKDIR /home/opf

EXPOSE 11435

HEALTHCHECK --interval=30s --timeout=5s --start-period=600s --retries=3 \
    CMD curl -fsS http://127.0.0.1:${OPF_API_PORT}/health || exit 1

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
